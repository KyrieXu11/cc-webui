# Feishu bots — Claude / Codex
# 把这份文件复制成 .env 并填好。.env 已在 .gitignore 中。
# 仅需要接入飞书时才填，本地 cc-webui 单机使用无需任何配置。

# ─────────────────────────────────────────────────────────────────────
# 功能开关（与飞书无关，本地单机也适用）
# ─────────────────────────────────────────────────────────────────────
# 多 agent 群聊：一个 turn 里让多个 agent 依次接话。默认关闭。
# 关闭时：网页群聊入口不出现、/api/groups 不挂载、飞书里 @ 谁谁回（各自单 agent）。
# 已有的群聊数据和 config 一行不改，重新打开就还在。
# CC_WEBUI_GROUPS_ENABLED=1

# 桌面客户端（Windows）的安装包目录。里面放安装包和一个 latest.json：
#   { "version": "1.2.0", "file": "cc-webui-setup-1.2.0.exe", "notes": "可选，显示在更新提示里" }
# /api/meta 读它下发 desktopClient 版本信息，客户端自己比 semver 决定是否提示。
# 没有 latest.json = 还没发布过客户端，desktopClient 字段整个不出现（不是错误）。
# 改完不用重启服务：每次 /api/meta 都重新读这个文件。
# CC_WEBUI_CLIENT_DIR=/Users/xuqiang/.cc-webui/client

# 首个管理员种子（user:password）。首启时若该账号不存在则创建，之后这一行可以删掉。
# 只会创建、绝不覆盖已存在的账号。注意：在创建出管理员之前，任何能访问端口的人
# 都能把自己变成管理员——所以先建号，再开放端口。
# CC_WEBUI_ADMIN=admin:change-me

# ─────────────────────────────────────────────────────────────────────
# 传输模式
# ─────────────────────────────────────────────────────────────────────
# 目前只支持 WebSocket 长连接（cc-webui 主动连飞书，不需要公网入口）。
# ⚠️ FEISHU_USE_WEBHOOK / webhook 模式【尚未实现】：config.ts 保留了 transportMode()
#    但没有任何调用方，server 永远只起 WS 通道，HTTP 事件端点固定返回 404。
# FEISHU_USE_WEBHOOK=1   # 暂不生效

# ─────────────────────────────────────────────────────────────────────
# Claude bot 凭据
# ─────────────────────────────────────────────────────────────────────
# 只需要 APP_ID + APP_SECRET（WS 模式）。
# ENCRYPT_KEY / VERIFY_TOKEN 仅 webhook 模式才用得到，而 webhook 目前未实现，故注释掉。
FEISHU_CLAUDE_APP_ID=
FEISHU_CLAUDE_APP_SECRET=
# FEISHU_CLAUDE_ENCRYPT_KEY=
# FEISHU_CLAUDE_VERIFY_TOKEN=

# Codex bot（可选；想在同一个飞书群里 @ 一个单独的 Codex 机器人时填写）
# FEISHU_CODEX_APP_ID=
# FEISHU_CODEX_APP_SECRET=
# FEISHU_CODEX_ENCRYPT_KEY=
# FEISHU_CODEX_VERIFY_TOKEN=

# 飞书群 @ 机器人时如果还没绑定 cc-webui group，会自动建一个新 group。
# 自动建的 group 默认 cwd（按优先级 fallback：本变量 > CC_WEBUI_CWD > server 启动目录）。
# 后续可以在飞书群里用 /cd <path> 切到别的目录。
# FEISHU_DEFAULT_CWD=/Users/xuqiang/code/cc-webui

# 可选：给人或外部 bot 配置 @ 别名。当前进程加载的 Claude/Codex bot 会自动注册
# claude / claude-bot / codex / codex-bot 等别名；这里主要用于人员或其他机器人。
# FEISHU_MENTION_ALIASES='{"alice":{"open_id":"ou_xxx","name":"Alice","aliases":["pm"]},"ops-bot":"ou_yyy"}'

# Override the OpenAPI base for Lark international (default: https://open.feishu.cn)
# ⚠️ FEISHU_BASE_URL 目前【未接线】：没有代码读取它，createLarkChannel 也没传 domain，
#    所以 Lark 国际版（larksuite.com）暂时用不了。详见 AGENTS.md「已知问题」。
# FEISHU_BASE_URL=https://open.larksuite.com

# Override dotenv path if .env lives elsewhere
# CC_WEBUI_DOTENV=/abs/path/to/.env
