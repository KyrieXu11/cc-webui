{
  "name": "@cc-webui/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "cc-webui 桌面客户端：托盘常驻，把服务端的 MCP 工具调用落在这台机器上执行。设计见 ../docs/desktop-client.md",
  "main": "dist/main.mjs",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node build.mjs",
    "dev": "electron .",
    "dist:win": "electron-builder --win nsis"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ws": "^8.20.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3"
  },
  "build": {
    "appId": "top.freeaitech.cc-webui",
    "productName": "cc-webui",
    "files": [
      "dist/**",
      "assets/**",
      "package.json"
    ],
    "asarUnpack": [
      "dist/servers/**"
    ],
    "extraMetadata": {
      "main": "dist/main.mjs"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    }
  }
}
